{
  "name": "achieve-music",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "main": "electron/main-embedded.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test tests",
    "tauri": "tauri",
    "dev:embedded": "tauri dev -- --features embedded-mode",
    "dev:server": "tauri dev -- --features server-mode",
    "build:embedded": "npm run build && tauri build -- --features embedded-mode",
    "build:server": "npm run build && tauri build -- --features server-mode",
    "build:all": "npm run build && tauri build -- --features embedded-mode && tauri build -- --features server-mode"
  },
  "dependencies": {
    "@meting/core": "^1.6.1",
    "@react-spring/web": "^10.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.6",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
